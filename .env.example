DATABASE_URL=postgresql://user:password@localhost:5432/fp_standalone
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-long-random-string
PORT=8080
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ── Stripe subscription ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# ── Admin ──────────────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=change-me-admin-secret
ADMIN_SEED_SECRET=change-me-one-time-seed-secret

# ── Compass CRM (served at /crm and /api/crm by this same server) ──────────────
# Uses its own Postgres schema "crm" in the same database (created automatically on first start).
# CRM_DATABASE_URL=            # optional; defaults to DATABASE_URL_CA / DATABASE_URL
# CRM_ENABLED=true             # set to false to skip loading the CRM
# SESSION_SECRET=              # (above) also signs CRM session cookies
EMAIL_ENC_KEY=change-me-long-random-passphrase     # REQUIRED for CRM email: encrypts connected-mailbox credentials (>=16 chars)
HOST_SUPERADMIN_EMAIL=         # optional: bootstrap the first CRM host super-admin on an empty crm schema
HOST_SUPERADMIN_PASSWORD=      # remove after first deploy
# CUSTOM_DOMAIN=               # CRM email OAuth callbacks: https://$CUSTOM_DOMAIN/api/crm/email/auth/{gmail,microsoft}/callback
# MICROSOFT_CLIENT_ID= / MICROSOFT_CLIENT_SECRET= / GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=   # optional email/calendar sync
# OPENAI_API_KEY= / ANTHROPIC_API_KEY=   # shared with Compass; used by CRM meeting notes + AI features
# RECALL_API_KEY= RECALL_WEBHOOK_SECRET= RECALL_ENABLED= TEAMS_BOT_APP_ID= TEAMS_BOT_APP_PASSWORD=   # optional
