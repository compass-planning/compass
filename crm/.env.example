# Compass CRM runs inside the Compass server (same process, same Fly app).
# These variables are read from the Compass environment — see the "Compass CRM" section
# of the root .env.example. Only build-time client settings are listed here.

# Idle-session timeout in minutes for signed-in CRM users (build-time; 0 disables). Default 15.
# VITE_IDLE_TIMEOUT_MINUTES=15
